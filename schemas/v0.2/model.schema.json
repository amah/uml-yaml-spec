{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uml-yaml.org/schemas/v0.2/model.schema.json",
  "title": "UML YAML v0.2 foundational metamodel (draft)",
  "description": "Partial UML v0.2 draft: structural, behavioral, interaction, use-case, and deployment vocabularies; not complete UML 2.5.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "packagedElements"
  ],
  "properties": {
    "apiVersion": {
      "const": "uml-yaml.org/v0.2"
    },
    "kind": {
      "const": "uml:Model"
    },
    "metadata": {
      "$ref": "#/$defs/identity"
    },
    "appliedProfiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "packagedElements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "documentation": {
          "type": "string"
        }
      }
    },
    "multiplicity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lower": {
          "type": "integer",
          "minimum": 0
        },
        "upper": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "const": "*"
            }
          ]
        }
      }
    },
    "valueSpecification": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "uml:LiteralString"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "uml:LiteralInteger"
            },
            "value": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "value"
          ],
          "properties": {
            "type": {
              "const": "uml:LiteralBoolean"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "uml:LiteralNull"
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "specification"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "constrainedElements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "specification": {
          "$ref": "#/$defs/valueSpecification"
        }
      }
    },
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "typeRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "typeRef": {
          "$ref": "#/$defs/reference"
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "protected",
            "package"
          ]
        },
        "multiplicity": {
          "$ref": "#/$defs/multiplicity"
        },
        "isReadOnly": {
          "type": "boolean"
        },
        "isDerived": {
          "type": "boolean"
        },
        "defaultValue": {
          "$ref": "#/$defs/valueSpecification"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "typeRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string"
        },
        "typeRef": {
          "$ref": "#/$defs/reference"
        },
        "direction": {
          "enum": [
            "in",
            "out",
            "inout",
            "return"
          ]
        },
        "multiplicity": {
          "$ref": "#/$defs/multiplicity"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "protected",
            "package"
          ]
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "ownedRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        }
      }
    },
    "associationEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string"
        },
        "typeRef": {
          "$ref": "#/$defs/reference"
        },
        "multiplicity": {
          "$ref": "#/$defs/multiplicity"
        },
        "aggregation": {
          "enum": [
            "none",
            "shared",
            "composite"
          ]
        }
      }
    },
    "tagDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "typeRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "typeRef": {
          "$ref": "#/$defs/reference"
        },
        "multiplicity": {
          "$ref": "#/$defs/multiplicity"
        }
      }
    },
    "stereotypeApplication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stereotypeRef"
      ],
      "properties": {
        "stereotypeRef": {
          "$ref": "#/$defs/reference"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/valueSpecification"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/valueSpecification"
                }
              }
            ]
          }
        }
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "uml:Package",
            "uml:Class",
            "uml:Interface",
            "uml:DataType",
            "uml:PrimitiveType",
            "uml:Enumeration",
            "uml:Component",
            "uml:Association",
            "uml:Profile",
            "uml:Stereotype",
            "uml:Dependency",
            "uml:Realization",
            "uml:Signal",
            "uml:Activity",
            "uml:StateMachine",
            "uml:Interaction",
            "uml:UseCase",
            "uml:Actor",
            "uml:Node",
            "uml:Device",
            "uml:ExecutionEnvironment",
            "uml:Artifact",
            "uml:DeploymentSpecification",
            "uml:Manifestation"
          ]
        },
        "visibility": {
          "enum": [
            "public",
            "private",
            "protected",
            "package"
          ]
        },
        "documentation": {
          "type": "string"
        },
        "packagedElements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "ownedAttributes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/property"
          }
        },
        "ownedOperations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "ownedRules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "generalizations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "literals": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "memberEnds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/associationEnd"
          }
        },
        "clients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "suppliers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metaclassRef"
            ],
            "properties": {
              "metaclassRef": {
                "$ref": "#/$defs/reference"
              },
              "isRequired": {
                "type": "boolean"
              }
            }
          }
        },
        "tagDefinitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tagDefinition"
          }
        },
        "appliedProfiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference"
          }
        },
        "stereotypeApplications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stereotypeApplication"
          }
        },
        "classifierDetails": {
          "$ref": "#/$defs/classifierClassifierDetails"
        },
        "enumerationLiterals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classifierEnumerationLiteral"
          }
        },
        "signalDetails": {
          "$ref": "#/$defs/classifierSignalDetails"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/behaviorNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityEdge"
          }
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        },
        "contextRef": {
          "type": "string",
          "minLength": 1
        },
        "isReentrant": {
          "type": "boolean"
        },
        "isReadOnly": {
          "type": "boolean"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string"
              },
              "states": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/state"
                }
              },
              "transitions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/transition"
                }
              }
            }
          }
        },
        "lifelines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lifeline"
          }
        },
        "occurrences": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "executions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/executionSpecification"
          }
        },
        "combinedFragments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/combinedFragment"
          }
        },
        "interactionUses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interactionUse"
          }
        },
        "generalOrderings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/generalOrdering"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actor"
          }
        },
        "useCaseRelationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/useCaseRelationship"
          }
        },
        "extensionPoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/extensionPoint"
          }
        },
        "subjectRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deploymentNodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deploymentNode"
          }
        },
        "communicationPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/communicationPath"
          }
        },
        "deployments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment"
          }
        },
        "manifestedElementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "uml:Association"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "memberEnds"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "uml:Stereotype"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "extensions"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "uml:Dependency",
                  "uml:Realization"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "clients",
              "suppliers"
            ]
          }
        }
      ]
    },
    "classifierReference": {
      "type": "string",
      "minLength": 1
    },
    "classifierVisibility": {
      "enum": [
        "public",
        "private",
        "protected",
        "package"
      ]
    },
    "classifierClassifierFlags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isAbstract": {
          "type": "boolean"
        },
        "isFinalSpecialization": {
          "type": "boolean"
        },
        "isLeaf": {
          "type": "boolean"
        }
      }
    },
    "classifierGeneralization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generalRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/classifierReference"
        },
        "generalRef": {
          "$ref": "#/$defs/classifierReference"
        },
        "isSubstitutable": {
          "type": "boolean"
        }
      }
    },
    "classifierInterfaceRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contractRef"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/classifierReference"
        },
        "contractRef": {
          "$ref": "#/$defs/classifierReference"
        }
      }
    },
    "classifierTemplateParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/classifierReference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameteredElementRef": {
          "$ref": "#/$defs/classifierReference"
        }
      }
    },
    "classifierClassifierDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "flags": {
          "$ref": "#/$defs/classifierClassifierFlags"
        },
        "generalizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classifierGeneralization"
          }
        },
        "interfaceRealizations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classifierInterfaceRealization"
          }
        },
        "templateParameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/classifierTemplateParameter"
          }
        }
      }
    },
    "classifierEnumerationLiteral": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/classifierReference"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "classifierSignalDetails": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ownedAttributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "typeRef"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/classifierReference"
              },
              "name": {
                "type": "string"
              },
              "typeRef": {
                "$ref": "#/$defs/classifierReference"
              }
            },
            "additionalProperties": false
          }
        }
      }
    },
    "behaviorNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "type": {
          "enum": [
            "uml:InitialNode",
            "uml:ActivityFinalNode",
            "uml:FlowFinalNode",
            "uml:OpaqueAction",
            "uml:DecisionNode",
            "uml:MergeNode",
            "uml:ForkNode",
            "uml:JoinNode"
          ]
        },
        "body": {
          "type": "string"
        }
      }
    },
    "activityEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sourceRef",
        "targetRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "uml:ControlFlow",
            "uml:ObjectFlow"
          ]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "$ref": "#/$defs/valueSpecification"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "uml:State",
            "uml:Pseudostate",
            "uml:FinalState"
          ]
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "initial",
            "choice",
            "junction",
            "fork",
            "join",
            "shallowHistory",
            "deepHistory",
            "entryPoint",
            "exitPoint",
            "terminate"
          ]
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceRef",
        "targetRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "targetRef": {
          "type": "string",
          "minLength": 1
        },
        "guard": {
          "$ref": "#/$defs/valueSpecification"
        },
        "triggerRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "lifeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "representsRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "coveredRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "uml:MessageOccurrenceSpecification",
            "uml:ExecutionOccurrenceSpecification",
            "uml:DestructionOccurrenceSpecification"
          ]
        },
        "coveredRef": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "messageSort",
        "sendEventRef",
        "receiveEventRef"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "messageSort": {
          "enum": [
            "synchCall",
            "asynchCall",
            "asynchSignal",
            "reply",
            "createMessage",
            "deleteMessage"
          ]
        },
        "sendEventRef": {
          "type": "string",
